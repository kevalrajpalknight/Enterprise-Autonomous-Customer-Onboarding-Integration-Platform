# Copy this file to .env and fill in real values. Never commit .env.

# ── Project ────────────────────────────────────────────────────────────────
PROJECT_NAME=OnboardAI
ENVIRONMENT=local

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=onboardai
POSTGRES_PASSWORD=onboardai-password
POSTGRES_DB=onboardai

# asyncpg driver required; host is the compose service name inside Docker
DATABASE_URL=postgresql+asyncpg://onboardai:onboardai-password@postgres:5432/onboardai

# ── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Separate DB index keeps results isolated from the task queue
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── AI APIs ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Upload ─────────────────────────────────────────────────────────────────
# 50 MB in bytes
MAX_UPLOAD_BYTES=52428800

# ── S3-compatible object storage ──────────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, etc.
# For Cloudflare R2 set: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# For local MinIO set:   S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=onboardai-documents
S3_REGION=us-east-1
