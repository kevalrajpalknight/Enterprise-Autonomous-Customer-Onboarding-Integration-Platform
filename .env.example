# Copy this file to .env and fill in real values. Never commit .env.

# ── Project ────────────────────────────────────────────────────────────────
PROJECT_NAME=OnboardAI
ENVIRONMENT=local

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=onboardai
POSTGRES_PASSWORD=onboardai-password
POSTGRES_DB=onboardai

# asyncpg driver required; host is the compose service name inside Docker
DATABASE_URL=postgresql+asyncpg://onboardai:onboardai-password@postgres:5432/onboardai

# ── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Separate DB index keeps results isolated from the task queue
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── AI APIs ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Upload ─────────────────────────────────────────────────────────────────
# 50 MB in bytes
MAX_UPLOAD_BYTES=52428800
